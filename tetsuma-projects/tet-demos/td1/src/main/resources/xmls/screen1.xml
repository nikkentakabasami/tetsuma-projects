<?xml version="1.0" encoding="UTF-8"?>
<Screen Stage="Main">
	<Title>Личный кабинет</Title>
	<Description>Выберите действие.
		И делайте что хочется.
		Или ничего.
	</Description>
	<Description2>
<![CDATA[
Зимний треугольник

